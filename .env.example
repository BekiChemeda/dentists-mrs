# Copy to .env on the server, then: chmod 600 .env
# Never commit .env. Generate secrets with:  openssl rand -base64 48 | tr -d '\n'

# --- Django -----------------------------------------------------------------
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-random-value-of-at-least-50-characters
# Addresses staff type in the browser (server IP and/or local DNS name)
DJANGO_ALLOWED_HOSTS=192.168.1.10,mrs.clinic.local,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://192.168.1.10,https://mrs.clinic.local

# --- HTTPS ------------------------------------------------------------------
# true  = HTTPS with certificates in deploy/certs (recommended, default)
# false = plain HTTP for a short trial on an isolated network only
MRS_HTTPS=true
HTTP_PORT=80
HTTPS_PORT=443

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=mrs
POSTGRES_USER=mrs
POSTGRES_PASSWORD=CHANGE-ME-long-random-password

# --- Security policy -------------------------------------------------------------
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10

# --- Phone app (docs/operations/phone-app.md) -------------------------------------
# Supplier public key(s) that sign the clinic licence. Given by the supplier; public, not secret.
MRS_VENDOR_PUBLIC_KEYS=
# SHA-256 of the supplier's app signing certificate. When set, modified or re-signed apps are refused.
MOBILE_APP_SIGNATURE_SHA256=
# Filled in by the installer from deploy/certs/server.crt.
MOBILE_TLS_CERT_SHA256=
# Leave true. false is only for development servers tested with phone emulators.
MOBILE_REQUIRE_HARDWARE_KEY=true

# --- Payments by phone (only if the licence includes them) ------------------------
# Hosts the egress relay may reach. Add the telebirr endpoint host given by Ethio Telecom when you use
# telebirr directly, e.g. EGRESS_ALLOWED_HOSTS=api.chapa.co,telebirr-host.ethiotelecom.et
EGRESS_ALLOWED_HOSTS=api.chapa.co

# --- Clinic -----------------------------------------------------------------------
MRS_FACILITY_CODE=CLN

# --- Operations ----------------------------------------------------------------
GUNICORN_WORKERS=3
LOG_LEVEL=INFO
BACKUP_DIR=/var/backups/mrs
# Dental images (radiographs, photographs): host directory, mirrored by the nightly backup.
IMAGE_DIR=/var/lib/mrs/images
# Largest image accepted (bytes). nginx allows uploads up to 30 MB on the image endpoint.
DENTAL_IMAGE_MAX_BYTES=26214400
# Optional: mounted external drive for a second copy of each backup
BACKUP_COPY_DIR=
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Optional off-site backup (docs/operations/offsite-backup.md). Switched on/off in the System page.
# Address of the encrypted storage; credentials may be part of the address or provider variables.
OFFSITE_REPOSITORY=
# The owner's secret phrase is written here by `offsite-backup.sh init`; never put it in this file.
OFFSITE_KEY_FILE=/etc/mrs/offsite.key
# Leave false with append-only storage; the provider then applies retention.
OFFSITE_PRUNE=false
